# TotalAnime 2.0 API Environment Configuration
PORT=4000
NODE_ENV=development

# Supabase Credentials (from Supabase Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
# Modern Secret Key or legacy Service Role Key
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_JWT_SECRET=your_jwt_secret_at_least_32_characters_long

# Scraper Configuration
SCRAPER_BASE_URL=https://tioanime.com/

# CORS Configuration (comma separated)
CORS_ORIGINS=https://totalanime.com,https://admin.totalanime.com,http://localhost:5173,http://localhost:5174,http://localhost:3000

# Worker Polling Interval in ms (default: 5000)
WORKER_POLL_INTERVAL_MS=5000
